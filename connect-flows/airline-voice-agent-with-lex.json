{
  "Version": "2019-10-30",
  "StartAction": "start-recording",
  "Metadata": {
    "entryPointPosition": { "x": 20, "y": 20 },
    "ActionMetadata": {
      "start-recording": { "position": { "x": 150, "y": 20 } },
      "init-lambda": { "position": { "x": 300, "y": 20 } },
      "welcome-message": { "position": { "x": 450, "y": 20 } },
      "get-customer-input": { "position": { "x": 600, "y": 20 } },
      "process-response": { "position": { "x": 750, "y": 20 } },
      "error-message": { "position": { "x": 450, "y": 200 } },
      "disconnect": { "position": { "x": 900, "y": 100 } }
    }
  },
  "Actions": [
    {
      "Identifier": "start-recording",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": {
          "RecordedParticipants": ["Agent", "Customer"]
        }
      },
      "Transitions": {
        "NextAction": "init-lambda"
      }
    },
    {
      "Identifier": "init-lambda",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:563146874500:function:dev-airline-contact-flow",
        "InvocationTimeLimitSeconds": "8"
      },
      "Transitions": {
        "NextAction": "welcome-message",
        "Errors": [
          { "NextAction": "welcome-message", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "welcome-message",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Welcome to SkyWay Airlines. I am your virtual assistant. How can I help you today? You can ask about flight changes, refunds, baggage, or delay compensation."
      },
      "Transitions": {
        "NextAction": "get-customer-input",
        "Errors": [
          { "NextAction": "error-message", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "get-customer-input",
      "Type": "GetParticipantInput",
      "Parameters": {
        "InputTimeLimitSeconds": "15",
        "LexV2Bot": {
          "AliasArn": "arn:aws:lex:us-east-1:563146874500:bot-alias/NLVRIWKCZR/CDYFS1W9KM"
        }
      },
      "Transitions": {
        "NextAction": "process-response",
        "Errors": [
          { "NextAction": "error-message", "ErrorType": "NoMatchingError" },
          { "NextAction": "error-message", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "error-message", "ErrorType": "NoInputError" }
        ]
      }
    },
    {
      "Identifier": "process-response",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "Thank you. Is there anything else I can help you with?"
      },
      "Transitions": {
        "NextAction": "get-customer-input",
        "Errors": [
          { "NextAction": "disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "error-message",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I am sorry, I did not understand. Please try again or say goodbye to end the call."
      },
      "Transitions": {
        "NextAction": "get-customer-input",
        "Errors": [
          { "NextAction": "disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
